# live.env — Bybit MAINNET canli motor
# Hacim + PiyasaEvresi tek kasada (Kasa_Canli, $100)
# Kopyala: copy live.env.example live.env

TRADING_MODE=bybit_mainnet
LIVE_TRADING_ENABLED=1
BYBIT_MAINNET_CONFIRM=YES_I_UNDERSTAND
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

LIVE_COMBO_LEDGER=Kasa_Canli
LIVE_KASA_USD=100
LIVE_STATE_FILE=live_state.json
LIVE_HTTP_PORT=10001
LIVE_LONG_ONLY=0
LIVE_MAX_NOTIONAL_USD=200

MAX_TOTAL_POSITIONS=3
MAX_POSITIONS_PER_KASA=3
RISK_PCT=0.035
SCAN_SYMBOLS=0
PRICE_POLL_SEC=20

GITHUB_TOKEN=
LAB_AUTO=0
CREW_AUTO=0
RESEARCH_ENABLED=0

ENGINE_URL=http://127.0.0.1:10001
KRPITO_MODE=live
