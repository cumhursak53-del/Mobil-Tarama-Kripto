# live.env — Bybit MAINNET canli motor
# Hacim + PiyasaEvresi tek kasada (Kasa_Canli, $100)
# Kopyala: copy live.env.example live.env

TRADING_MODE=bybit_mainnet
# 1 = Bybit emir gonder | 0 = yalnizca tarama (emir yok)
LIVE_TRADING_ENABLED=0
BYBIT_MAINNET_CONFIRM=YES_I_UNDERSTAND
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

LIVE_COMBO_LEDGER=Kasa_Canli
LIVE_KASA_USD=100
LIVE_STATE_FILE=live_state.json
LIVE_HTTP_PORT=10001
LIVE_LONG_ONLY=0
LIVE_MAX_NOTIONAL_USD=200

MAX_TOTAL_POSITIONS=3
MAX_POSITIONS_PER_KASA=3
LIVE_STRATEGY_MAX_POSITIONS=Kasa_Hacim:2,Kasa_PiyasaEvresi:1
RISK_PCT=0.035
SCAN_SYMBOLS=0
SCAN_CRYPTO_ONLY=1
PRICE_POLL_SEC=20
SIGNAL_LOG_RESET_HOUR=3
SIGNAL_WATCH_HOURS=24

GITHUB_TOKEN=
LAB_AUTO=0
CREW_AUTO=0
RESEARCH_ENABLED=0

ENGINE_URL=http://127.0.0.1:10001
# PC arayuzunden VPS motorunu izlemek icin (launch_krpito_live_ui.bat):
# Hostinger firewall'da 10001 acik olmali veya SSH tuneli kullanin
REMOTE_ENGINE_URL=http://76.13.150.125:10001
KRPITO_MODE=live
